# Neon Postgres connection strings.
# DATABASE_URL  — pooled connection (used at runtime by the app).
# DIRECT_URL    — direct connection (used by Prisma Migrate / seeding).
# In the Neon dashboard, copy the pooled string for DATABASE_URL and the
# direct (non-pooled) string for DIRECT_URL. Add both to Vercel env vars.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
